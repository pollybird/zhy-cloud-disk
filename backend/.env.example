# ===== 钟毓私有云盘 环境变量（可选，优先级高于安装向导落盘配置）=====

# 运行环境：development / production
ZHY_ENV=production
# 监听地址与端口（仅 python run.py 使用）
ZHY_HOST=0.0.0.0
ZHY_PORT=5000

# ===== 数据库（二选一）=====
# 方式一：完整连接串（Docker 静默初始化也使用该变量）
# ZHY_DATABASE_URL=mysql+pymysql://root:pwd@127.0.0.1:3306/zhycloud?charset=utf8mb4
# 方式二：拆分参数
# ZHY_DB_TYPE=mysql
# ZHY_DB_HOST=127.0.0.1
# ZHY_DB_PORT=3306
# ZHY_DB_NAME=zhycloud
# ZHY_DB_USER=root
# ZHY_DB_PASSWORD=

# ===== 静默初始化（仅全新环境首启，配合 ZHY_DATABASE_URL 或拆分参数）=====
# ZHY_ADMIN_USERNAME=admin
# ZHY_ADMIN_PASSWORD=ChangeMe123
# ZHY_ADMIN_EMAIL=admin@example.com

# ===== 其他可覆盖配置 =====
# ZHY_STORAGE_DIR=/data/zhycloud/storage
# ZHY_INSTANCE_DIR=/data/zhycloud/instance
# ZHY_SECRET_KEY=请修改为随机串
# ZHY_JWT_SECRET_KEY=请修改为随机串
# ZHY_DEFAULT_QUOTA=5368709120
# ZHY_MAX_UPLOAD_SIZE=2147483648
# ZHY_ALLOW_REGISTER=true
# ZHY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ZHY_JWT_ACCESS_HOURS=2
# ZHY_JWT_REFRESH_DAYS=30

# ===== Redis 缓存（可选）=====
# 配置后用于：系统设置缓存、分享密码限频、JWT 吊销列表、插件状态同步
# 留空或不配置时系统正常运行（降级为进程内内存缓存）
# ZHY_REDIS_URL=redis://127.0.0.1:6379/0
