# ============================================================
# zhyCloudDisk Docker 部署环境变量
# 复制为 .env 后按需修改：cp .env.example .env
# 仅首次静默安装时生效的变量已在注释中标明；存量数据修改无效。
# ============================================================

# ---- Web 访问端口（frontend nginx 映射到宿主机的端口） ----
ZHY_WEB_PORT=8080

# ---- 超级管理员（仅首次静默安装生效） ----
ZHY_ADMIN_USERNAME=admin
ZHY_ADMIN_PASSWORD=Admin12345
ZHY_ADMIN_EMAIL=admin@zhy.local

# ---- 部门共享网盘（仅首次静默安装生效；默认关闭） ----
# 开启后安装即启用多级部门共享网盘；存量实例请在系统设置中切换。
ZHY_DEPARTMENT_DRIVE=false

# ---- 数据库（默认 SQLite，数据存于 backend-instance 卷，无需额外配置） ----
ZHY_DB_TYPE=sqlite
# 切换 MySQL 时填写下列分项（并确认 MySQL 版本 8.0+）：
# ZHY_DB_HOST=mysql
# ZHY_DB_PORT=3306
# ZHY_DB_NAME=zhycloud
# ZHY_DB_USER=zhycloud
# ZHY_DB_PASSWORD=change_me
# 或直接给 DSN（优先级最高，覆盖上面分项）：
# ZHY_DATABASE_URL=mysql+pymysql://user:pass@host:3306/zhycloud

# ---- Redis（compose 已内置；留空会降级为进程内内存缓存） ----
ZHY_REDIS_URL=redis://redis:6379/0

# ---- JWT 有效期 ----
ZHY_JWT_ACCESS_HOURS=2
ZHY_JWT_REFRESH_DAYS=30

# ---- 个人网盘默认配额（字节；5368709120 = 5GiB） ----
ZHY_DEFAULT_QUOTA=5368709120

# ---- CORS 允许源（默认 *；限定域名示例：https://disk.example.com） ----
ZHY_CORS_ORIGINS=*

# ---- 后端直连端口（排障用；默认仅绑定宿主机回环口） ----
# 需要局域网直连后端时改为 0.0.0.0:5000，常规部署无需修改。
ZHY_BACKEND_PORT=127.0.0.1:5000
