# ============================================================
# zhyCloudDisk Docker 部署环境变量
# 复制为 .env 后按需修改：cp .env.example .env
# 仅首次静默安装时生效的变量已在注释中标明；存量数据修改无效。
# 镜像内置 MySQL + Redis，无需配置数据库连接。
# ============================================================

# ---- Web 访问端口（映射到宿主机的端口） ----
ZHY_WEB_PORT=8080

# ---- 超级管理员（仅首次静默安装生效） ----
# H1：不再提供默认密码。推荐执行 ./deploy.sh init 自动生成强随机密码；
# 手动生成（Linux/macOS）：openssl rand -base64 18 | tr -d '/+=' | cut -c1-20
# 密码要求 8-64 位且同时包含字母和数字，禁止使用 Admin12345 等示例值。
ZHY_ADMIN_USERNAME=admin
ZHY_ADMIN_PASSWORD=请替换为强随机密码
ZHY_ADMIN_EMAIL=admin@zhy.local

# ---- 部门共享网盘（仅首次静默安装生效；默认开启） ----
# 开启后安装即启用多级部门共享网盘；存量实例请在系统设置中切换。
ZHY_DEPARTMENT_DRIVE=true

# ---- JWT 有效期 ----
ZHY_JWT_ACCESS_HOURS=2
ZHY_JWT_REFRESH_DAYS=30

# ---- 个人网盘默认配额（字节；5368709120 = 5GiB） ----
ZHY_DEFAULT_QUOTA=5368709120

# ---- CORS 允许源（默认留空=禁止跨域；一体化镜像前后端同源无需修改。
#      独立域名前端部署示例：ZHY_CORS_ORIGINS=https://disk.example.com；
#      本地开发可置 * 或 http://localhost:5173） ----
ZHY_CORS_ORIGINS=
